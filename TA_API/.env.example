# ============================================================
# Telemetry Trust Analyser — Environment Variables Example
# ============================================================
# Copy this file to .env and fill in your actual values.
# .env is gitignored — never commit secrets.
#
# To get started:
#   cp .env.example .env
#   # Edit .env with your deployment-specific values

# --- MongoDB ---
# Full MongoDB connection URI
MONGO_URI=mongodb://localhost:27017/

# Name of the database to use
DB_NAME=telemetry

# Note: MongoDB collection names are application constants and do not need to
# be configured here. They are defined in api/database.py.

# --- ADI / External Service Integration ---
# IP address of the ADI instance.
# Used to build ADI_SERVICE_URL if ADI_SERVICE_URL is not explicitly set.
# Set to "localhost" to disable ADI integration (skips ADI report sending).
SERVICE_IP=localhost

# Full URL of the ADI REST API.
# Defaults to http://{SERVICE_IP}:9002 if not set.
ADI_SERVICE_URL=http://localhost:9002

# --- API Server ---
# Port for the FastAPI application
API_PORT=8001

# Comma-separated list of allowed CORS origins.
# Use * to allow all origins (suitable for development).
# For production, specify exact origins: http://yourdomain.com,https://yourdomain.com
CORS_ORIGINS=*
